includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/tomasvotruba/type-coverage/config/extension.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - phar://phpstan.phar/conf/bleedingEdge.neon
    - vendor/calebdw/fakerstan/extension.neon

parameters:

    type_coverage:
        return: 100
        param: 100
        property: 100
        declare: 100

#    bladestan:
#        template_paths:
#            - resources/views

#    unused_public:
#        methods: false
#        properties: false
#        constants: false

    paths:
        - app
        - database


    # PHPStan levels go from 0 (loosest) to 9 (strictest, "max"). We're at 5,
    # with 100% type coverage already — there's room to raise this gradually.
    level: 5

    ignoreErrors:

    excludePaths:

    editorUrl: 'phpstorm://open?file=%%file%%&line=%%line%%'

    universalObjectCratesClasses:
        - Illuminate\Database\Eloquent\Relations\Pivot


