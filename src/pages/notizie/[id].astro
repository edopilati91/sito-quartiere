---
import type { GetStaticPaths } from 'astro';
import { getImage, Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formattaData, tutteLeNotizie } from '../../notizie';

export const getStaticPaths = (async () => {
    const notizie = await tutteLeNotizie();
    return notizie.map((notizia) => ({ params: { id: notizia.id }, props: { notizia } }));
}) satisfies GetStaticPaths;

const { notizia } = Astro.props;
const { titolo, data, riassunto, volantino, volantinoAlt } = notizia.data;
const { Content } = await render(notizia);
const baseUrl = import.meta.env.BASE_URL;
// Larger version of the flyer, opened by clicking on it.
const volantinoGrande = volantino && (await getImage({ src: volantino, width: 1400 }));
---

<BaseLayout title={titolo} description={riassunto}>
    <article class="mx-auto max-w-6xl px-4 py-14 sm:px-8 lg:py-20">
        <p>
            <a href={`${baseUrl}notizie/`} class="text-neutral-600 underline-offset-4 hover:underline">← Notizie</a>
        </p>

        <div class:list={['mt-10 grid gap-12', volantino && 'lg:grid-cols-[1fr_380px] lg:gap-16']}>
            <div>
                <p class="occhiello text-verde"><time datetime={data}>{formattaData(data)}</time></p>
                <h1 class="mt-3 text-4xl font-normal leading-tight sm:text-5xl">{titolo}</h1>
                <div class="testo mt-8">
                    <Content />
                </div>
            </div>

            {
                volantino && volantinoGrande && (
                    <a href={volantinoGrande.src} class="block self-start" title="Apri il volantino a grandezza piena">
                        <Image
                            src={volantino}
                            alt={volantinoAlt ?? `Volantino: ${titolo}`}
                            widths={[380, 760]}
                            sizes="(min-width: 1024px) 380px, 100vw"
                            class="h-auto w-full shadow-[0_30px_60px_-20px_rgb(0_0_0/0.45)]"
                        />
                    </a>
                )
            }
        </div>
    </article>
</BaseLayout>
