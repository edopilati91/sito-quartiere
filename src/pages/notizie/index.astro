---
import { Image } from 'astro:assets';
import chiostro from '../../assets/storia/chiostro.jpg';
import TestataPagina from '../../components/TestataPagina.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formattaData, tutteLeNotizie } from '../../notizie';

const baseUrl = import.meta.env.BASE_URL;
const notizie = await tutteLeNotizie();
---

<BaseLayout title="Notizie" description="Avvisi, appuntamenti e iniziative del Quartiere San Fortunato.">
    <TestataPagina titolo="Notizie" occhiello="Avvisi e appuntamenti del quartiere" immagine={chiostro} />

    <section class="mx-auto max-w-4xl px-4 py-20 sm:px-8 lg:py-28">
        {notizie.length === 0 && <p class="text-center text-lg text-neutral-700">Al momento non ci sono notizie.</p>}
        <ul class="divide-y divide-black/10">
            {
                notizie.map((n) => (
                    <li>
                        <a href={`${baseUrl}notizie/${n.id}/`} class="group flex items-start gap-6 py-10 sm:gap-10">
                            <div class="flex-1">
                                <p class="occhiello text-verde">
                                    <time datetime={n.data.data}>{formattaData(n.data.data)}</time>
                                </p>
                                <h2 class="mt-2 text-3xl font-normal leading-tight group-hover:text-verde">{n.data.titolo}</h2>
                                <p class="mt-3 text-lg leading-relaxed text-neutral-700">{n.data.riassunto}</p>
                            </div>
                            {n.data.volantino && (
                                <Image
                                    src={n.data.volantino}
                                    alt=""
                                    width={160}
                                    densities={[1, 2]}
                                    class="hidden w-28 shrink-0 shadow-[0_20px_40px_-20px_rgb(0_0_0/0.45)] sm:block sm:w-40"
                                />
                            )}
                        </a>
                    </li>
                ))
            }
        </ul>
    </section>
</BaseLayout>
