---
import complessoEBrenta from '../assets/drone/complesso-e-brenta.jpg';
import Bottone from '../components/Bottone.astro';
import TestataPagina from '../components/TestataPagina.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../site.config';

const { sede } = siteConfig;
const indirizzoCompleto = `${sede.indirizzo}, ${sede.cap} ${siteConfig.luogo}`;
// OpenStreetMap embed (no cookies), framed around the seat
const mappa = `https://www.openstreetmap.org/export/embed.html?bbox=${sede.lon - 0.006},${sede.lat - 0.003},${sede.lon + 0.006},${sede.lat + 0.003}&layer=mapnik&marker=${sede.lat},${sede.lon}`;
const googleMaps = `https://www.google.com/maps/search/?api=1&query=${sede.lat},${sede.lon}`;
---

<BaseLayout title="Contatti" description="Come contattare il Consiglio di Quartiere San Fortunato.">
    <TestataPagina titolo="Contatti" occhiello="Consiglio di Quartiere San Fortunato" immagine={complessoEBrenta} />

    <section class="mx-auto max-w-7xl px-4 py-24 sm:px-8 lg:py-32">
        <div class="rivela">
            <div class="text-center">
                <p class="occhiello">Scriveteci</p>
                <h2 class="mt-4 text-4xl font-normal leading-tight sm:text-6xl">Il Consiglio è a disposizione del quartiere</h2>
            </div>

            <dl class="mt-16 grid gap-x-16 gap-y-8 md:grid-cols-2 lg:mt-20">
                <div class="border-b border-black/10 pb-6">
                    <dt class="occhiello text-sm text-neutral-600">Presidente del Consiglio di Quartiere</dt>
                    <dd class="mt-2 text-2xl font-normal">Luisa Bizzotto</dd>
                </div>
                <div class="border-b border-black/10 pb-6">
                    <dt class="occhiello text-sm text-neutral-600">Email</dt>
                    <dd class="mt-2 break-all text-2xl font-normal">
                        <a href={`mailto:${siteConfig.email}`} class="underline-offset-4 hover:text-verde hover:underline">
                            {siteConfig.email}
                        </a>
                    </dd>
                </div>
                <div class="border-b border-black/10 pb-6">
                    <dt class="occhiello text-sm text-neutral-600">Facebook</dt>
                    <dd class="mt-2 text-2xl font-normal">
                        <a href={siteConfig.facebook} class="underline-offset-4 hover:text-verde hover:underline">
                            Quartiere San Fortunato Bassano del Grappa
                        </a>
                    </dd>
                </div>
                <div class="border-b border-black/10 pb-6">
                    <dt class="occhiello text-sm text-neutral-600">Instagram</dt>
                    <dd class="mt-2 text-2xl font-normal">
                        <a href={siteConfig.instagram} class="underline-offset-4 hover:text-verde hover:underline">
                            @quartiere_san_fortunato
                        </a>
                    </dd>
                </div>
            </dl>

            <div class="mt-14 text-center">
                <Bottone href={`mailto:${siteConfig.email}`}>Scrivi una email</Bottone>
            </div>
        </div>
    </section>

    <section class="border-t border-black/10" aria-labelledby="dove-siamo">
        <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 py-24 sm:px-8 lg:grid-cols-[2fr_3fr] lg:py-32">
            <div class="rivela">
                <p class="occhiello">Dove siamo</p>
                <h2 id="dove-siamo" class="mt-4 text-4xl font-normal leading-tight sm:text-5xl">
                    La sede del Consiglio di Quartiere
                </h2>
                <address class="mt-8 text-xl not-italic leading-relaxed">
                    {sede.indirizzo}<br />
                    {sede.cap} {siteConfig.luogo} ({siteConfig.provincia}), Veneto
                </address>
                <p class="mt-4 text-lg leading-relaxed text-neutral-700">A pochi passi dal monastero di San Fortunato.</p>
                <div class="mt-10">
                    <Bottone href={googleMaps} variante="vuoto">Indicazioni stradali</Bottone>
                </div>
            </div>
            <div class="rivela border border-black/10">
                <iframe
                    src={mappa}
                    title={`Mappa: sede del Consiglio di Quartiere, ${indirizzoCompleto}`}
                    loading="lazy"
                    class="block aspect-[4/3] w-full"
                ></iframe>
            </div>
        </div>
    </section>
</BaseLayout>
