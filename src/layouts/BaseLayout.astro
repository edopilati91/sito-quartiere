---
import '../styles/global.css';
import { siteConfig } from '../site.config';

interface Props {
    title?: string;
    description?: string;
}

const { title, description = siteConfig.description } = Astro.props;
const pageTitle = title ? `${title} - ${siteConfig.name}` : siteConfig.name;
const baseUrl = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang={siteConfig.lang}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
        <link rel="icon" href={`${baseUrl}favicon.ico`} />
        <title>{pageTitle}</title>
    </head>
    <body class="flex min-h-screen flex-col bg-white text-neutral-900 antialiased">
        <header class="border-b border-neutral-200">
            <div class="mx-auto max-w-5xl px-4 py-4">
                <a href={baseUrl} class="font-semibold">{siteConfig.name}</a>
            </div>
        </header>

        <main class="flex-1">
            <slot />
        </main>

        <footer class="border-t border-neutral-200 text-sm text-neutral-600">
            <div class="mx-auto max-w-5xl px-4 py-6">
                © {new Date().getFullYear()} {siteConfig.name} · Bassano del Grappa
            </div>
        </footer>
    </body>
</html>
