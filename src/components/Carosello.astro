---
// Horizontal list of cards with arrow buttons. The cards (<li>) go in the slot.
interface Props {
    titolo: string;
}

const { titolo } = Astro.props;
---

<div class="carosello">
    <div class="mx-auto flex max-w-7xl items-end justify-between gap-6 px-4 sm:px-8">
        <h2 class="rivela text-4xl font-normal sm:text-5xl">{titolo}</h2>
        <div class="hidden shrink-0 gap-2 sm:flex">
            <button
                type="button"
                data-direzione="-1"
                class="flex size-12 items-center justify-center rounded-full border border-black/20 transition-colors hover:border-black disabled:opacity-30"
            >
                <span class="sr-only">Precedente</span>
                <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M15 5l-7 7 7 7"></path>
                </svg>
            </button>
            <button
                type="button"
                data-direzione="1"
                class="flex size-12 items-center justify-center rounded-full border border-black/20 transition-colors hover:border-black disabled:opacity-30"
            >
                <span class="sr-only">Successiva</span>
                <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M9 5l7 7-7 7"></path>
                </svg>
            </button>
        </div>
    </div>
    <ul
        class="mt-12 flex snap-x snap-mandatory scroll-px-4 gap-6 overflow-x-auto px-4 pb-4 [scrollbar-width:none] sm:scroll-px-8 sm:px-8 lg:scroll-px-[max(2rem,calc((100vw-80rem)/2+2rem))] lg:px-[max(2rem,calc((100vw-80rem)/2+2rem))]"
    >
        <slot />
    </ul>
</div>

<script>
    // Arrow buttons scroll the list by one card.
    for (const carosello of document.querySelectorAll<HTMLElement>('.carosello')) {
        const lista = carosello.querySelector('ul');
        if (!lista) continue;
        for (const bottone of carosello.querySelectorAll<HTMLButtonElement>('[data-direzione]')) {
            bottone.addEventListener('click', () => {
                const passo = (lista.firstElementChild?.getBoundingClientRect().width ?? 300) + 24;
                lista.scrollBy({ left: Number(bottone.dataset.direzione) * passo, behavior: 'smooth' });
            });
        }
    }
</script>
